dist
node_modules

# Local credentials for the integration suite. Never commit: this is a
# Hookdeck project API key with full read/write on that project.
.env
.env.*
!.env.example

# `hookdeck ci --local` writes a project API key here. Keep it out of git —
# the CLI must be pinned to this project for test/live, and the global
# ~/.config/hookdeck/config.toml is usually pointed somewhere else.
.hookdeck/

# Local n8n state, if N8N_USER_FOLDER is pointed inside the repo
.n8n/
.n8n-local/

# Claude Code worktrees, which are clones of this repo and must never be
# committed into it.
.claude/worktrees/

# Video production - narration, recording walkthrough, slide deck, captured
# stills, YouTube listing. Launch marketing rather than package documentation,
# and it lives with the rest of that work outside this repo. Ignored here so a
# regenerate cannot quietly add it back.
demo/stills/
demo/deck.html
demo/NARRATION.md
demo/WALKTHROUGH.md
demo/DECK.md
demo/YOUTUBE.md
demo/captions.srt

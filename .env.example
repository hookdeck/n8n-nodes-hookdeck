# Copy to .env and fill in. .env is gitignored.
#
# API key for a Hookdeck Event Gateway project, from Project Settings → Secrets.
# The integration suite creates and deletes real sources, destinations and
# connections, so point this at a throwaway project — never one carrying live
# traffic.
#
#   npm run test:integration
#
# The same value belongs in the HOOKDECK_EG_API_KEY repository secret, which is
# what the Integration workflow reads in CI:
#
#   gh secret set HOOKDECK_EG_API_KEY < <(grep '^HOOKDECK_EG_API_KEY=' .env | cut -d= -f2-)
HOOKDECK_EG_API_KEY=
